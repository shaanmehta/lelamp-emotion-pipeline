    "trace": {
      "dialogue_id": 17,
      "turns": [
        {
          "uid": "dia17_utt0",
          "t_ms": 0.0,
          "text": "Hey. When you guys were kids and you played",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.8986
        },
        {
          "uid": "dia17_utt1",
          "t_ms": 3127.0,
          "text": "I was always Joanne.",
          "gold": "neutral",
          "raw": "joy",
          "smoothed": "neutral",
          "confidence": 0.4651
        },
        {
          "uid": "dia17_utt2",
          "t_ms": 6796.0,
          "text": "Question. Was ah, \u2018Egg the Gellers!\u2019 the war cry of your neighbourhood?",
          "gold": "neutral",
          "raw": "joy",
          "smoothed": "joy",
          "confidence": 0.4442
        },
        {
          "uid": "dia17_utt3",
          "t_ms": 11049.0,
          "text": "Ewww! Oh! It\u2019s the Mattress King!",
          "gold": "disgust",
          "raw": "joy",
          "smoothed": "joy",
          "confidence": 0.5159
        },
        {
          "uid": "dia17_utt4",
          "t_ms": 12841.0,
          "text": "Don\u2019t look honey. Change the channel! Change the channel!",
          "gold": "disgust",
          "raw": "anger",
          "smoothed": "joy",
          "confidence": 0.3615
        },
        {
          "uid": "dia17_utt5",
          "t_ms": 14508.0,
          "text": "Wait! Wait! I wanna see this. After I divorce him, half of that kingdom is gonna be mine.",
          "gold": "joy",
          "raw": "sadness",
          "smoothed": "joy",
          "confidence": 0.2762
        },
        {
          "uid": "dia17_utt6",
          "t_ms": 20430.0,
          "text": "What a wank!",
          "gold": "anger",
          "raw": "disgust",
          "smoothed": "joy",
          "confidence": 0.2348
        },
        {
          "uid": "dia17_utt7",
          "t_ms": 22306.0,
          "text": "Oh, I cannot believe he\u2019s using our divorce to sell mattresses.",
          "gold": "anger",
          "raw": "sadness",
          "smoothed": "sadness",
          "confidence": 0.3466
        },
        {
          "uid": "dia17_utt8",
          "t_ms": 26351.0,
          "text": "I know!",
          "gold": "anger",
          "raw": "anger",
          "smoothed": "sadness",
          "confidence": 0.223
        },
        {
          "uid": "dia17_utt9",
          "t_ms": 30521.0,
          "text": "And four ninety-nine for a pillow top queen set, who cares about the divorce, those babies",
          "gold": "anger",
          "raw": "neutral",
          "smoothed": "sadness",
          "confidence": 0.2756
        },
        {
          "uid": "dia17_utt10",
          "t_ms": 32855.0,
          "text": "And I\u2019m appalled for you by the way.",
          "gold": "anger",
          "raw": "disgust",
          "smoothed": "sadness",
          "confidence": 0.3272
        },
        {
          "uid": "dia17_utt11",
          "t_ms": 35691.0,
          "text": "You had to do it, didn\u2019t you? You couldn\u2019t just leave it alone.",
          "gold": "sadness",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.3273
        },
        {
          "uid": "dia17_utt12",
          "t_ms": 37859.0,
          "text": "Four percent. Okay. I tip more than that when there\u2019s a bug in my food.",
          "gold": "disgust",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.4451
        },
        {
          "uid": "dia17_utt13",
          "t_ms": 42362.0,
          "text": "Ross, tonight was about the two of you getting along.  Oh, would you just see my chiroprac",
          "gold": "anger",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.3901
        },
        {
          "uid": "dia17_utt14",
          "t_ms": 48242.0,
          "text": "Yeah, I\u2019m gonna go to a doctor who went to school in a mini-mall.",
          "gold": "disgust",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.5548
        },
        {
          "uid": "dia17_utt15",
          "t_ms": 52328.0,
          "text": "Hey Pheebs, what are you doing?",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.6226
        },
        {
          "uid": "dia17_utt16",
          "t_ms": 54329.0,
          "text": "I\u2019m, I\u2019m freaking out!",
          "gold": "fear",
          "raw": "joy",
          "smoothed": "neutral",
          "confidence": 0.2649
        },
        {
          "uid": "dia17_utt17",
          "t_ms": 57164.0,
          "text": "Monica kinda trusted me with something and she shouldn\u2019t have!",
          "gold": "fear",
          "raw": "surprise",
          "smoothed": "neutral",
          "confidence": 0.2744
        },
        {
          "uid": "dia17_utt18",
          "t_ms": 61041.0,
          "text": "All right, I haven\u2019t lived here in a while, so I have to ask you something.",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.4745
        },
        {
          "uid": "dia17_utt19",
          "t_ms": 64002.0,
          "text": "Does Monica still turn on the lights in her bedroom?",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.4887
        },
        {
          "uid": "dia17_utt20",
          "t_ms": 66379.0,
          "text": "Um. yeah.",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.7081
        },
        {
          "uid": "dia17_utt21",
          "t_ms": 67401.0,
          "text": "I am",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.7779
        },
        {
          "uid": "dia17_utt22",
          "t_ms": 68727.0,
          "text": "All right, look, here\u2019s the bottom line Ross, this is fixable, if we act fast, okay.",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.8367
        },
        {
          "uid": "dia17_utt23",
          "t_ms": 73355.0,
          "text": "So, I\u2019ll invite him to brunch tomorrow and you can make nice.",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.871
        },
        {
          "uid": "dia17_utt24",
          "t_ms": 76149.0,
          "text": "Look, honey, I have tried to make nice, it doesn\u2019t work.",
          "gold": "anger",
          "raw": "sadness",
          "smoothed": "neutral",
          "confidence": 0.4526
        },
        {
          "uid": "dia17_utt25",
          "t_ms": 79401.0,
          "text": "Okay, look, Ross, I realise that my Father is difficult, but that\u2019s why you have got to be",
          "gold": "neutral",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.4537
        },
        {
          "uid": "dia17_utt26",
          "t_ms": 85323.0,
          "text": "Look sweetie, I could be the bigger man, I could be the biggest man, I could be a big, hug",
          "gold": "anger",
          "raw": "anger",
          "smoothed": "anger",
          "confidence": 0.4495
        },
        {
          "uid": "dia17_utt27",
          "t_ms": 97501.0,
          "text": "Like me tiny doctor!\u2019",
          "gold": "anger",
          "raw": "anger",
          "smoothed": "anger",
          "confidence": 0.4944
        },
        {
          "uid": "dia17_utt28",
          "t_ms": 101880.0,
          "text": "Okay, well can\u2019t you just try it one more time Ross? For me? For me?",
          "gold": "sadness",
          "raw": "sadness",
          "smoothed": "anger",
          "confidence": 0.3625
        },
        {
          "uid": "dia17_utt29",
          "t_ms": 105383.0,
          "text": "Rachel one brunch is not gonna solve anything. You gotta face it, okay we\u2019re never gonna g",
          "gold": "anger",
          "raw": "sadness",
          "smoothed": "anger",
          "confidence": 0.3649
        },
        {
          "uid": "dia17_utt30",
          "t_ms": 110471.0,
          "text": "Okay, well you are just gonna have too, okay.",
          "gold": "anger",
          "raw": "neutral",
          "smoothed": "neutral",
          "confidence": 0.4441
        },
        {
          "uid": "dia17_utt31",
          "t_ms": 112722.0,
          "text": "Because I already got a Mother and a Father who cannot stay in the same room together, oka",
          "gold": "anger",
          "raw": "anger",
          "smoothed": "anger",
          "confidence": 0.5256
        },
        {
          "uid": "dia17_utt32",
          "t_ms": 118477.0,
          "text": "Okay, okay, okay.  I\u2019ll get the bagels.",
          "gold": "neutral",
          "raw": "neutral",
